# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==========================================

# Port for Express server
# Note: Frontend and Admin clients connect to port 5001 by default
PORT=5001

# MongoDB Connection String
# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/ai-interview-app
# MongoDB Atlas:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.wgiqq.mongodb.net/AI?appName=Cluster0

# JWT Secret for user authentication and authorization
JWT_SECRET=your_jwt_secret_key_change_in_production

# Initial Admin Credentials (auto-seeded when server connects to database)
ADMIN_EMAIL=admin@intervexa.com
ADMIN_PASSWORD=Admin@12345

# Google Gemini API Key (for AI interview questions, roadmap generation, and assessment analysis)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Judge0 Code Execution API (Optional)
# For RapidAPI Judge0 CE:
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
# For Local Judge0 (running via docker-compose in /judge0):
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=

